{
	"name": "classeviva-mcp",
	"version": "0.1.0",
	"description": "MCP server for the ClasseViva school register, running on Cloudflare Workers behind Cloudflare Access.",
	"license": "MIT",
	"private": true,
	"type": "module",
	"engines": {
		"node": ">=22"
	},
	"scripts": {
		"deploy": "wrangler deploy --secrets-file .env",
		"dev": "wrangler dev",
		"start": "wrangler dev",
		"cf-typegen": "wrangler types",
		"type-check": "tsc --noEmit"
	},
	"dependencies": {
		"@cloudflare/workers-oauth-provider": "^0.10.3",
		"@modelcontextprotocol/client": "^2.0.0",
		"@modelcontextprotocol/sdk": "1.30.0",
		"@modelcontextprotocol/server": "^2.0.0",
		"agents": "^0.23.0",
		"hono": "^4.13.8",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@cloudflare/workers-types": "^5.20260916.1",
		"@types/node": "^22.20.3",
		"tsx": "^4.20.0",
		"typescript": "^5.9.0",
		"wrangler": "^4.132.0"
	}
}
