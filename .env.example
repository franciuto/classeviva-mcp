# Copy to `.env` and fill in. This file does double duty:
#
#   - `npm run dev`    reads it for local development
#   - `npm run deploy` uploads it as the Worker's secrets
#     (the script passes --secrets-file .env)
#
# So `.env` IS the source of truth for production. Two consequences:
# a missing `.env` makes the deploy fail outright with ENOENT, and everything
# in here is uploaded — keep it to the nine names below.
#
# Uploading is additive: secrets already on the Worker but absent from this
# file are preserved, never deleted.

# From your Cloudflare Access for SaaS (OIDC) application
ACCESS_CLIENT_ID=<client id>
ACCESS_CLIENT_SECRET=<client secret>
ACCESS_AUTHORIZATION_URL=https://<team>.cloudflareaccess.com/cdn-cgi/access/sso/oidc/<app>/authorization
ACCESS_TOKEN_URL=https://<team>.cloudflareaccess.com/cdn-cgi/access/sso/oidc/<app>/token
ACCESS_JWKS_URL=https://<team>.cloudflareaccess.com/cdn-cgi/access/sso/oidc/<app>/jwks

# Generated: openssl rand -hex 32
COOKIE_ENCRYPTION_KEY=<random hex>
LINK_SIGNING_KEY=<random hex>

# Your ClasseViva login
CLASSEVIVA_ID=<e.g. S1234567X>
CLASSEVIVA_PASSWORD=<password>
